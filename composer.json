{
    "name": "clypper-technology/role-pricing",
    "description": "Role-based pricing and quantity price breaks for WooCommerce.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-only",

    "require": {
        "php": ">=8.2"
    },

    "autoload": {
        "psr-4": {
            "ClypperTechnology\\RolePricing\\": "includes/"
        }
    },

    "autoload-dev": {
        "psr-4": {
            "Generators\\": "tests/Generators/"
        }
    },

    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.0",
        "php-stubs/woocommerce-stubs": "^11.0",
        "phpunit/php-invoker": "^7.0",
        "phpunit/phpunit": "^13.3",
        "phpunit/php-timer": "^9.0"
    },

    "scripts": {
      "test": "phpunit tests"
    }
}
